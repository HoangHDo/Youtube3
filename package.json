{
  "name": "cyberstream",
  "version": "1.0.0",
  "private": true,
  "description": "CYBERSTREAM - a Tesla-dashboard-style player that streams video from any YouTube URL in the browser.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "doctor": "node scripts/doctor.js",
    "prepare-runtime": "node scripts/prepare-runtime.js",
    "prebuild": "node scripts/prepare-runtime.js",
    "postinstall": "node scripts/prepare-runtime.js && node scripts/doctor.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "optionalDependencies": {
    "@distube/ytdl-core": "^4.11.5"
  }
}
