# CYBERSTREAM configuration (all optional).
# For hosted deploys, add these as "environment variables" in your dashboard.

# yt-dlp is REQUIRED. The pure-JS @distube/ytdl-core fallback no longer parses
# current YouTube responses and fails with "Failed to find any playable
# formats", so a server without yt-dlp can show metadata but cannot play video.
# The included Dockerfile and render.yaml both install it for you.
#
# Datacenter/cloud IPs are often served a bot-check page instead of the player
# response, which also breaks resolution. YTDLP_PLAYER_CLIENT below is what
# makes hosted deployments work in practice.
YTDLP_PATH=
YTDLP_PLAYER_CLIENT=default,android,web

# Optional: needed for age-gated or region-locked videos only.
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_PROXY=

# HTTP server
PORT=5173
HOST=0.0.0.0

# HMAC key used to sign proxy URLs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty a random key is generated at boot (links stop working on restart).
PROXY_SECRET=

# Hard cap on the quality the server will hand out.
MAX_QUALITY=1080

# Upstream User-Agent used when talking to YouTube/Google.
UPSTREAM_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# How long resolved stream URLs stay cached in memory (ms). Signed proxied
# links are re-issued from the cache so seeking keeps working.
CACHE_TTL_MS=300000

# Network timeouts (ms)
UPSTREAM_TIMEOUT_MS=20000
PROXY_TIMEOUT_MS=120000


